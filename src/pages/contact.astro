---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
---

<BaseLayout
  title="Contact Hustle & Rise"
  description="Contact Hustle & Rise about corrections, partnerships, training, or general questions."
>
  <section class="relative overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-28 dark-gradient">
    <div class="absolute inset-0 subtle-grid" aria-hidden="true"></div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="section-eyebrow">Contact</p>
      <h1 class="font-serif text-4xl font-bold sm:text-6xl">Let’s talk about something useful.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/70">
        Send us corrections, partnership ideas, training enquiries, or questions about Hustle & Rise.
      </p>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="max-w-4xl mx-auto grid gap-px border border-white/10 bg-white/10 md:grid-cols-2">
      <div class="bg-slate-950 p-7 sm:p-10">
        <p class="font-brand text-xs font-bold uppercase tracking-[0.16em] text-electric">Email</p>
        <h2 class="mt-4 font-serif text-2xl font-bold">Start a conversation</h2>
        <p class="mt-3 leading-relaxed text-white/60">Email is the reliable contact channel while a validated website form is being prepared.</p>
        <a href={`mailto:${site.email}`} class="btn-electric mt-7">{site.email}</a>
      </div>
      <div class="bg-slate-950 p-7 sm:p-10">
        <p class="font-brand text-xs font-bold uppercase tracking-[0.16em] text-electric">Helpful details</p>
        <h2 class="mt-4 font-serif text-2xl font-bold">What to include</h2>
        <ul class="mt-5 grid gap-3 text-white/60">
          <li>• The page or opportunity you are referring to</li>
          <li>• The correction, question, or proposal</li>
          <li>• The best way to follow up with you</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
