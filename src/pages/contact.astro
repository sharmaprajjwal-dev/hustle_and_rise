---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
---

<BaseLayout title="Contact Hustle & Rise" description="Contact Hustle & Rise about corrections, partnerships, training, or general questions.">
  <section class="relative overflow-hidden px-4 pb-20 pt-16 sm:px-6 sm:pb-24 sm:pt-20 lg:px-8 lg:pt-24">
    <div class="subtle-grid absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-5xl text-center" data-reveal>
      <p class="section-eyebrow">Contact</p>
      <h1 class="font-brand text-5xl font-extrabold leading-[1.02] tracking-[-0.065em] sm:text-6xl lg:text-7xl">Let’s talk about something useful.</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-[#687081]">Send us corrections, partnership ideas, training enquiries, or questions about Hustle & Rise.</p>
    </div>
  </section>

  <section class="px-4 pb-24 sm:px-6 sm:pb-28 lg:px-8">
    <div class="mx-auto grid max-w-5xl overflow-hidden rounded-[2rem] border border-black/[0.06] bg-white shadow-[0_28px_80px_rgba(31,37,54,0.11)] md:grid-cols-2" data-reveal>
      <div class="bg-[#5b5ce2] p-8 text-white sm:p-12">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-white/65">Email</p>
        <h2 class="mt-4 font-brand text-3xl font-extrabold tracking-[-0.04em] text-white">Start a conversation</h2>
        <p class="mt-4 leading-7 text-white/72">Email is our reliable contact channel while a validated website form is being prepared.</p>
        <a href={`mailto:${site.email}`} class="mt-8 inline-flex rounded-full bg-white px-5 py-3 text-sm font-bold text-[#4546c9]">{site.email}</a>
      </div>
      <div class="p-8 sm:p-12">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#ff6b35]">Helpful details</p>
        <h2 class="mt-4 font-brand text-3xl font-extrabold tracking-[-0.04em]">What to include</h2>
        <ol class="mt-7 grid gap-5 text-[#687081]">
          {["The page or opportunity you are referring to", "The correction, question, or proposal", "The best way to follow up with you"].map((item, index) => <li class="flex gap-3"><span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-[#fff0e8] text-xs font-bold text-[#ff6b35]">{index + 1}</span><span class="pt-0.5">{item}</span></li>)}
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>
