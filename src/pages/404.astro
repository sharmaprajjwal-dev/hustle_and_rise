---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | Hustle & Rise" description="This Hustle & Rise page could not be found. Continue to current jobs, practical guides, or the homepage." noindex>
  <section class="error-page">
    <div class="subtle-grid absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-32" data-reveal>
      <span class="error-code" aria-hidden="true">404</span>
      <p class="section-eyebrow">Wrong turn</p>
      <h1>This page has moved—or never existed.</h1>
      <p>The link may be outdated or the address may contain a typo. Choose a useful next step below.</p>
      <div class="error-actions"><a class="btn-electric" href="/">Return to jobs</a><a class="btn-outline-electric" href="/blog">Read career guides</a></div>
      <nav aria-label="Helpful links"><a href="/interview">Interview prep</a><a href="/career">Career toolkit</a><a href="/blog">Practical guides</a><a href="/contact">Contact us</a></nav>
    </div>
  </section>
</BaseLayout>

<style>
  .error-page{position:relative;display:grid;min-height:70vh;place-items:center;overflow:hidden;background:linear-gradient(135deg,#fff7f1,#fbfaf7 55%,#eeeeff)}.error-code{display:block;color:rgba(91,92,226,.12);font-family:var(--font-brand);font-size:clamp(6rem,22vw,12rem);font-weight:800;line-height:.75}.error-page .section-eyebrow{margin-top:2rem}.error-page h1{margin:0;font-size:clamp(2.2rem,6vw,4.2rem);font-weight:800;line-height:1.05}.error-page>div>p:not(.section-eyebrow){max-width:38rem;margin:1.3rem auto 0;color:var(--ink-soft);line-height:1.7}.error-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:.8rem;margin-top:2rem}.error-page nav{display:flex;flex-wrap:wrap;justify-content:center;gap:1rem 1.5rem;margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid var(--line)}.error-page nav a{color:var(--blue);font-size:.78rem;font-weight:750}
</style>
