---
import JobCard from "../../components/JobCard.astro";
import JobListAdSlot from "../../components/JobListAdSlot.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getActiveJobs } from "../../lib/jobs/queries.server";

const jobs = await getActiveJobs();
const unique = (values: Array<string | null>) => [...new Set(values.filter((value): value is string => Boolean(value)))].sort();
const locations = unique(jobs.map((job) => job.location));
const jobTypes = unique(jobs.map((job) => job.job_type));
const categories = unique(jobs.map((job) => job.category));
const label = (value: string) => value.replaceAll("-", " ").replace(/\b\w/g, (letter) => letter.toUpperCase());
---

<BaseLayout title="Remote jobs and flexible work | Hustle & Rise" description="Search current remote and flexible roles from approved job sources, with clear locations, job types, dates, and direct application links.">
  <section class="jobs-hero">
    <div class="jobs-orb jobs-orb-one" aria-hidden="true"></div>
    <div class="jobs-orb jobs-orb-two" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
      <div class="max-w-3xl" data-reveal>
        <p class="section-eyebrow">Find work</p>
        <h1>Find a role that fits <span>your real life.</span></h1>
        <p class="jobs-intro">Search current opportunities from approved sources. Every listing links directly to the original job page—no invented details and no signup wall.</p>
        <div class="jobs-proof" aria-label="Job board highlights">
          <span><strong>{jobs.length}</strong> current roles</span>
          <span><i aria-hidden="true"></i> Verified source links</span>
          <span>Updated regularly</span>
        </div>
      </div>
    </div>
  </section>

  <section class="jobs-browser" aria-labelledby="jobs-heading">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      {jobs.length > 0 ? (
        <>
          <form class="jobs-filters" id="job-filters" role="search" aria-controls="jobs-grid" data-analytics-form="job_filter_used">
            <div class="filter-field filter-search">
              <label for="job-keyword">Search jobs</label>
              <input id="job-keyword" name="q" type="search" placeholder="Job title, company or keyword" autocomplete="off" />
            </div>
            <div class="filter-field">
              <label for="job-location">Location</label>
              <select id="job-location" name="location"><option value="">All locations</option>{locations.map((location) => <option value={location.toLowerCase()}>{location}</option>)}</select>
            </div>
            <div class="filter-field">
              <label for="job-type">Job type</label>
              <select id="job-type" name="type"><option value="">All job types</option>{jobTypes.map((type) => <option value={type.toLowerCase()}>{label(type)}</option>)}</select>
            </div>
            <div class="filter-field">
              <label for="job-category">Category</label>
              <select id="job-category" name="category"><option value="">All categories</option>{categories.map((category) => <option value={category.toLowerCase()}>{category}</option>)}</select>
            </div>
            <div class="filter-field">
              <label for="job-date">Date posted</label>
              <select id="job-date" name="days"><option value="">Any time</option><option value="1">Past 24 hours</option><option value="7">Past week</option><option value="30">Past month</option></select>
            </div>
            <label class="remote-toggle"><input id="job-remote" name="remote" type="checkbox" value="1" /><span aria-hidden="true"></span> Remote only</label>
            <button class="filter-reset" id="job-reset" type="reset">Clear filters</button>
          </form>

          <div class="jobs-results-heading">
            <div><p class="section-eyebrow">Live opportunities</p><h2 id="jobs-heading">Latest roles</h2></div>
            <p id="jobs-count" role="status" aria-live="polite">Showing {Math.min(9, jobs.length)} of {jobs.length} roles</p>
          </div>
          <div class="jobs-grid" id="jobs-grid">{jobs.map((job) => <JobCard job={job} />)}</div>
          <JobListAdSlot />
          <div class="jobs-empty" id="jobs-empty" hidden><span aria-hidden="true">⌕</span><h2>No matching roles yet</h2><p>Try broadening your filters or clearing the search.</p></div>
          {jobs.length > 9 && <div class="load-more-wrap"><button class="btn-outline-electric" id="load-more" type="button">Show more roles <span aria-hidden="true">↓</span></button></div>}
        </>
      ) : (
        <div class="jobs-empty jobs-empty-static">
          <span aria-hidden="true">↻</span><h1>Fresh roles are on the way</h1>
          <p>The job feed is not connected in this environment yet. Explore the career and interview guides while it is being prepared.</p>
          <div class="flex flex-wrap justify-center gap-3"><a class="btn-electric" href="/career">Career toolkit</a><a class="btn-outline-electric" href="/interview">Interview prep</a></div>
        </div>
      )}
    </div>
  </section>

  <section class="jobs-guidance">
    <div class="mx-auto grid max-w-7xl gap-5 px-4 py-14 sm:px-6 md:grid-cols-3 lg:px-8 lg:py-20">
      <a class="guidance-card" href="/career"><span>01</span><h2>Strengthen your CV</h2><p>Practical guidance for presenting your experience clearly.</p></a>
      <a class="guidance-card" href="/interview"><span>02</span><h2>Prepare to interview</h2><p>Build confident answers before the conversation starts.</p></a>
      <a class="guidance-card" href="/training"><span>03</span><h2>Build useful skills</h2><p>Explore learning pathways that support your next move.</p></a>
    </div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>("#job-filters");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-job-card]")];
    const count = document.querySelector<HTMLElement>("#jobs-count");
    const empty = document.querySelector<HTMLElement>("#jobs-empty");
    const loadMore = document.querySelector<HTMLButtonElement>("#load-more");
    let visibleLimit = 9;

    const field = (name: string) => form?.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
    const applyFilters = () => {
      if (!form) return;
      const query = field("q")?.value.trim().toLowerCase() ?? "";
      const selectedLocation = field("location")?.value ?? "";
      const type = field("type")?.value ?? "";
      const category = field("category")?.value ?? "";
      const days = Number(field("days")?.value || 0);
      const remote = (field("remote") as HTMLInputElement | null)?.checked ?? false;
      const cutoff = days ? Date.now() - days * 86_400_000 : 0;
      const matched = cards.filter((card) =>
        (!query || card.dataset.search?.includes(query)) &&
        (!selectedLocation || card.dataset.location === selectedLocation) &&
        (!type || card.dataset.type === type) &&
        (!category || card.dataset.category === category) &&
        (!remote || card.dataset.remote === "true") &&
        (!cutoff || (card.dataset.published && new Date(card.dataset.published).getTime() >= cutoff))
      );
      cards.forEach((card) => { card.hidden = !matched.includes(card) || matched.indexOf(card) >= visibleLimit; });
      empty?.toggleAttribute("hidden", matched.length !== 0);
      if (count) count.textContent = `Showing ${Math.min(visibleLimit, matched.length)} of ${matched.length} ${matched.length === 1 ? "role" : "roles"}`;
      if (loadMore) loadMore.hidden = matched.length <= visibleLimit;

      const params = new URLSearchParams(new FormData(form) as never);
      for (const [key, value] of [...params]) if (!value) params.delete(key);
      history.replaceState(null, "", `${window.location.pathname}${params.size ? `?${params}` : ""}`);
    };

    if (form) {
      const params = new URLSearchParams(location.search);
      for (const [name, value] of params) {
        const control = field(name);
        if (control instanceof HTMLInputElement && control.type === "checkbox") control.checked = value === "1";
        else if (control) control.value = value;
      }
      form.addEventListener("input", () => { visibleLimit = 9; applyFilters(); });
      form.addEventListener("reset", () => setTimeout(() => { visibleLimit = 9; applyFilters(); }));
      loadMore?.addEventListener("click", () => { visibleLimit += 9; applyFilters(); });
      applyFilters();
    }
  </script>
</BaseLayout>

<style>
  .jobs-hero { position:relative; overflow:hidden; background:linear-gradient(135deg,#fff7f1 0%,#fbfaf7 55%,#eeeeff 100%); }
  .jobs-hero::after { position:absolute; inset:0; opacity:.18; background-image:radial-gradient(rgba(91,92,226,.4) 1px,transparent 1px); background-size:25px 25px; mask-image:linear-gradient(90deg,transparent,black); content:""; }
  .jobs-hero h1 { position:relative; z-index:1; margin:0; max-width:48rem; font-size:clamp(2.8rem,7vw,5.7rem); font-weight:800; line-height:.98; }
  .jobs-hero h1 span { color:var(--orange); }
  .jobs-intro { position:relative; z-index:1; max-width:42rem; margin:1.5rem 0 0; color:var(--ink-soft); font-size:1.05rem; line-height:1.75; }
  .jobs-proof { position:relative; z-index:1; display:flex; flex-wrap:wrap; gap:.75rem 1.5rem; margin-top:2rem; color:#616a7b; font-size:.82rem; font-weight:650; }
  .jobs-proof strong { color:var(--ink); }
  .jobs-proof i { display:inline-block; width:.55rem; height:.55rem; margin-right:.3rem; border-radius:50%; background:var(--aqua); box-shadow:0 0 0 6px rgba(35,185,179,.12); }
  .jobs-orb { position:absolute; z-index:0; border-radius:50%; filter:blur(1px); }
  .jobs-orb-one { right:8%; bottom:-7rem; width:21rem; height:21rem; border:4rem solid rgba(255,107,53,.09); }
  .jobs-orb-two { top:-5rem; right:34%; width:10rem; height:10rem; background:rgba(35,185,179,.08); }
  .jobs-browser { background:var(--paper); }
  .jobs-filters { position:relative; z-index:3; display:grid; gap:1rem; margin-top:-5.5rem; padding:1.25rem; border:1px solid rgba(23,32,51,.08); border-radius:1.7rem; background:rgba(255,255,255,.96); box-shadow:0 24px 65px rgba(30,38,57,.12); }
  .filter-field { display:grid; gap:.4rem; }
  .filter-field label { color:#6b7383; font-size:.68rem; font-weight:750; letter-spacing:.06em; text-transform:uppercase; }
  .filter-field input,.filter-field select { width:100%; min-height:3rem; padding:.7rem .85rem; border:1px solid var(--line); border-radius:.8rem; background:#fbfaf7; color:var(--ink); font:inherit; font-size:.84rem; }
  .remote-toggle { display:flex; min-height:3rem; align-items:center; gap:.65rem; align-self:end; color:var(--ink); font-size:.8rem; font-weight:700; cursor:pointer; }
  .remote-toggle input { position:absolute; opacity:0; }
  .remote-toggle span { position:relative; width:2.6rem; height:1.45rem; border-radius:99px; background:#d9d8d4; transition:background .2s ease; }
  .remote-toggle span::after { position:absolute; top:.2rem; left:.2rem; width:1.05rem; height:1.05rem; border-radius:50%; background:#fff; box-shadow:0 2px 6px rgba(0,0,0,.2); content:""; transition:transform .2s ease; }
  .remote-toggle input:checked + span { background:var(--blue); }
  .remote-toggle input:checked + span::after { transform:translateX(1.15rem); }
  .remote-toggle input:focus-visible + span { outline:3px solid var(--orange); outline-offset:3px; }
  .filter-reset { align-self:end; min-height:3rem; border:0; background:transparent; color:var(--blue); font-size:.78rem; font-weight:750; cursor:pointer; }
  .jobs-results-heading { display:flex; align-items:end; justify-content:space-between; gap:1rem; margin:4rem 0 1.5rem; }
  .jobs-results-heading .section-eyebrow { margin-bottom:.4rem; }
  .jobs-results-heading h2 { margin:0; font-size:clamp(2rem,4vw,3rem); }
  .jobs-results-heading > p { color:#737b8a; font-size:.8rem; }
  .jobs-grid { display:grid; gap:1.25rem; }
  .jobs-empty { padding:4rem 1rem; text-align:center; }
  .jobs-empty[hidden] { display:none; }
  .jobs-empty span { display:grid; width:4.5rem; height:4.5rem; margin:0 auto 1.25rem; place-items:center; border-radius:1.4rem; background:var(--blue-soft); color:var(--blue); font-size:2rem; }
  .jobs-empty h1,.jobs-empty h2 { margin:0; font-size:2rem; }
  .jobs-empty p { max-width:35rem; margin:1rem auto 1.5rem; color:var(--ink-soft); }
  .load-more-wrap { display:flex; justify-content:center; margin-top:2.5rem; }
  .load-more-wrap button[hidden] { display:none; }
  .jobs-guidance { background:#172033; }
  .guidance-card { position:relative; overflow:hidden; padding:2rem; border:1px solid rgba(255,255,255,.09); border-radius:1.4rem; background:rgba(255,255,255,.045); transition:background .2s ease, transform .2s ease; }
  .guidance-card:hover { background:rgba(255,255,255,.08); transform:translateY(-4px); }
  .guidance-card span { color:#ff9a73; font-size:.72rem; font-weight:800; }
  .guidance-card h2 { margin:.9rem 0 .5rem; color:#fff; font-size:1.15rem; }
  .guidance-card p { margin:0; color:rgba(255,255,255,.58); font-size:.86rem; line-height:1.65; }
  @media (min-width:640px) { .jobs-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (min-width:768px) { .jobs-filters { grid-template-columns:2fr repeat(2,1fr); } }
  @media (min-width:1024px) { .jobs-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } .jobs-filters { grid-template-columns:2fr 1.2fr 1fr 1.2fr 1fr auto auto; align-items:end; } }
  @media (max-width:639px) { .jobs-results-heading { align-items:flex-start; flex-direction:column; } }
</style>
