---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { productSections, site } from "../config/site";

const articles = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const jobCategories = ["Student jobs", "Part-time", "Internships", "Graduate", "Remote", "Weekend work"];
---

<BaseLayout
  title="Hustle & Rise | Find Work. Build Skills. Earn More."
  description={site.description}
>
  <section class="relative min-h-[88vh] overflow-hidden dark-gradient pt-28 sm:pt-32">
    <div class="absolute inset-0 subtle-grid" aria-hidden="true"></div>
    <div class="absolute -right-24 top-20 h-80 w-80 rounded-full bg-electric/10 blur-3xl" aria-hidden="true"></div>

    <div class="relative max-w-7xl mx-auto grid min-h-[calc(88vh-7rem)] items-center gap-12 px-4 pb-16 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:px-8">
      <div class="max-w-3xl">
        <p class="section-eyebrow">New Zealand + remote opportunities</p>
        <h1 class="font-serif text-5xl font-bold leading-[1.04] sm:text-6xl lg:text-7xl">
          Find Work.<br />
          <span class="electric-text">Build Skills.</span><br />
          Earn More.
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-white/70 sm:text-xl">
          Practical jobs, interview preparation, career guidance, training, and realistic earning ideas for students and early-career people.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="/jobs" class="btn-electric">Explore jobs</a>
          <a href="/career" class="btn-outline-electric">Build your career</a>
        </div>
      </div>

      <aside class="border border-white/10 bg-white/[0.035] p-6 sm:p-8" aria-label="Hustle & Rise pathway">
        <p class="font-brand text-xs font-bold uppercase tracking-[0.18em] text-electric">One connected journey</p>
        <ol class="mt-6 space-y-6">
          {[
            ["01", "Discover", "Find a suitable role or earning opportunity."],
            ["02", "Prepare", "Use focused interview and application guidance."],
            ["03", "Grow", "Build practical skills that widen your options."],
          ].map(([number, title, description]) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-4 border-t border-white/10 pt-5 first:border-0 first:pt-0">
              <span class="font-brand text-sm font-bold text-electric">{number}</span>
              <div>
                <h2 class="font-serif text-xl font-bold">{title}</h2>
                <p class="mt-1 text-sm leading-relaxed text-white/55">{description}</p>
              </div>
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </section>

  <section class="border-y border-white/10 bg-slate-950 px-4 py-12 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="section-eyebrow">Start with work</p>
          <h2 class="font-serif text-3xl font-bold sm:text-4xl">Explore the jobs people need now.</h2>
        </div>
        <a href="/jobs" class="text-sm font-semibold text-electric">Jobs hub →</a>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        {jobCategories.map((category) => (
          <span class="border border-white/15 px-4 py-2 text-sm text-white/65">{category}</span>
        ))}
      </div>
      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-white/45">
        Automated listings are not live yet. The next stage adds validated feeds, source attribution, deduplication, and expiry handling before any job appears here.
      </p>
    </div>
  </section>

  <section class="px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl">
        <p class="section-eyebrow">More than a job board</p>
        <h2 class="font-serif text-4xl font-bold leading-tight sm:text-5xl">Everything connects to your next step.</h2>
        <p class="mt-5 text-lg leading-relaxed text-white/60">Move from finding an opportunity to preparing, learning, and earning—without jumping between unrelated sites.</p>
      </div>

      <div class="mt-12 grid gap-px border border-white/10 bg-white/10 md:grid-cols-2 lg:grid-cols-3">
        {productSections.map((section, index) => (
          <a href={section.href} class="group bg-slate-950 p-7 text-white transition-colors hover:bg-white/[0.04] sm:p-8">
            <div class="flex items-center justify-between">
              <span class="font-brand text-xs font-bold uppercase tracking-[0.16em] text-electric">{section.eyebrow}</span>
              <span class="text-xs text-white/30">{String(index + 1).padStart(2, "0")}</span>
            </div>
            <h3 class="mt-8 font-serif text-2xl font-bold group-hover:text-electric">{section.title}</h3>
            <p class="mt-3 leading-relaxed text-white/55">{section.description}</p>
            <span class="mt-7 inline-block text-sm font-semibold text-electric">Explore {section.shortTitle} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.025] px-4 py-20 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="section-eyebrow">From the library</p>
          <h2 class="font-serif text-3xl font-bold sm:text-4xl">Current practical guides</h2>
        </div>
        <a href="/blog" class="text-sm font-semibold text-electric">View all articles →</a>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {articles.map((article) => (
          <article class="border border-white/10 bg-slate-950">
            <div class="p-6">
              <p class="font-brand text-xs font-bold uppercase tracking-[0.14em] text-electric">{article.data.category}</p>
              <h3 class="mt-3 font-serif text-xl font-bold leading-snug">
                <a href={`/blog/${article.id}`} class="text-white hover:text-electric">{article.data.title}</a>
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-white/55 line-clamp-3">{article.data.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
    <div class="max-w-5xl mx-auto border border-electric/30 bg-electric/[0.055] p-8 text-center sm:p-12">
      <p class="section-eyebrow justify-center">Build skills</p>
      <h2 class="font-serif text-3xl font-bold sm:text-4xl">Practical training is coming first.</h2>
      <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-white/65">The initial catalogue will focus on hands-on classes such as the 20-Day Photoshop Class, followed by job-readiness and digital-skills workshops.</p>
      <a href="/training" class="btn-electric mt-8">Explore training</a>
    </div>
  </section>
</BaseLayout>
