---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const classes = (await getCollection("training", ({ data }) => !data.draft)).sort((a,b) => Number(b.data.featured) - Number(a.data.featured));
const statusLabel = (status: string) => status === "planned" ? "Register interest" : status.charAt(0).toUpperCase() + status.slice(1);
---

<BaseLayout title="Practical Training & Classes | Hustle & Rise" description="Practical classes and short workshops designed around employability, creative work, and useful digital skills.">
  <section class="training-hero">
    <div class="subtle-grid absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24" data-reveal>
      <p class="section-eyebrow">Build skills</p><h1>Learn by making <span>useful work.</span></h1>
      <p>Practical classes and workshops built around real outputs, clear expectations, and skills you can keep developing.</p>
    </div>
  </section>
  <section class="class-list"><div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
    <div class="class-heading"><div><p class="section-eyebrow">Class catalogue</p><h2>Start with a practical pathway.</h2></div><p>{classes.length} {classes.length === 1 ? "class" : "classes"} currently listed</p></div>
    <div class="class-grid">{classes.map((course) => <article class="class-card"><div class="class-visual"><span>{course.data.category}</span><strong>{course.data.duration}</strong><i aria-hidden="true">Ps</i></div><div class="class-copy"><div><span class={`status status-${course.data.status}`}>{statusLabel(course.data.status)}</span><span>{course.data.skillLevel}</span></div><h2><a href={`/training/${course.id}/`}>{course.data.title}</a></h2><p>{course.data.description}</p><dl><div><dt>Format</dt><dd>{course.data.deliveryMode}</dd></div><div><dt>Schedule</dt><dd>{course.data.schedule ?? "To be announced"}</dd></div></dl><a href={`/training/${course.id}/`}>View class plan →</a></div></article>)}</div>
  </div></section>
  <section class="training-principles"><div class="mx-auto grid max-w-7xl gap-5 px-4 py-14 sm:px-6 md:grid-cols-3 lg:px-8"><article><span>01</span><h2>Learn through practice</h2><p>Each class is organised around useful exercises and tangible outputs.</p></article><article><span>02</span><h2>Know what to expect</h2><p>Status, schedule, requirements, and price appear only when confirmed.</p></article><article><span>03</span><h2>Keep progressing</h2><p>Connect new skills to career guidance, job opportunities, and realistic services.</p></article></div></section>
</BaseLayout>

<style>
  .training-hero{position:relative;overflow:hidden;background:linear-gradient(135deg,#eef0ff,#fbfaf7 58%,#fff1e9)}
  .training-hero h1{max-width:52rem;margin:0;font-size:clamp(2.8rem,7vw,5.7rem);font-weight:800;line-height:1}.training-hero h1 span{color:var(--blue)}
  .training-hero p:not(.section-eyebrow){max-width:42rem;margin:1.5rem 0 0;color:var(--ink-soft);font-size:1.05rem;line-height:1.75}
  .class-list{background:var(--paper)}.class-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1.8rem}.class-heading .section-eyebrow{margin-bottom:.3rem}.class-heading h2{margin:0;font-size:clamp(2rem,4vw,3rem)}.class-heading>p{color:#7a8291;font-size:.8rem}
  .class-grid{display:grid;gap:1.5rem}.class-card{display:grid;overflow:hidden;border:1px solid rgba(23,32,51,.08);border-radius:1.8rem;background:#fff;box-shadow:var(--shadow-sm)}
  .class-visual{position:relative;display:flex;min-height:18rem;flex-direction:column;justify-content:space-between;padding:1.7rem;overflow:hidden;background:linear-gradient(140deg,#5b5ce2,#7778f2);color:#fff}.class-visual::after{position:absolute;right:-4rem;bottom:-5rem;width:15rem;height:15rem;border:3rem solid rgba(255,255,255,.08);border-radius:50%;content:""}.class-visual span,.class-visual strong{position:relative;z-index:1;font-size:.72rem;text-transform:uppercase;letter-spacing:.08em}.class-visual i{position:relative;z-index:1;align-self:center;font-family:var(--font-brand);font-size:6rem;font-style:normal;font-weight:800;letter-spacing:-.1em}.class-copy{display:flex;flex-direction:column;padding:1.8rem}.class-copy>div{display:flex;align-items:center;justify-content:space-between;color:#7a8290;font-size:.72rem}.status{padding:.4rem .65rem;border-radius:999px;background:var(--orange-soft);color:var(--orange-dark);font-weight:800}.class-copy h2{margin:1.5rem 0 .8rem;font-size:1.6rem}.class-copy p{margin:0;color:#667082;line-height:1.7}.class-copy dl{display:grid;gap:.8rem;margin:1.5rem 0}.class-copy dl div{display:flex;justify-content:space-between;padding-top:.75rem;border-top:1px solid var(--line);font-size:.78rem}.class-copy dt{color:#8a91a0}.class-copy dd{margin:0;color:var(--ink);font-weight:700;text-transform:capitalize}.class-copy>a{margin-top:auto;color:var(--blue);font-size:.82rem;font-weight:800}
  .training-principles{background:#172033}.training-principles article{padding:1.5rem;border:1px solid rgba(255,255,255,.08);border-radius:1.3rem;background:rgba(255,255,255,.04)}.training-principles span{color:#ff9a73;font-size:.7rem;font-weight:800}.training-principles h2{margin:1rem 0 .5rem;color:#fff;font-size:1.08rem}.training-principles p{margin:0;color:rgba(255,255,255,.58);font-size:.82rem;line-height:1.65}
  @media(min-width:768px){.class-card{grid-template-columns:minmax(16rem,.8fr) 1.2fr}.class-copy{padding:2.2rem}}
  @media(max-width:639px){.class-heading{align-items:flex-start;flex-direction:column}}
</style>
