---
import BaseLayout from "../layouts/BaseLayout.astro";
import { productSections, site } from "../config/site";
---

<BaseLayout title="About Hustle & Rise" description={site.description}>
  <section class="relative overflow-hidden px-4 pb-20 pt-16 sm:px-6 sm:pb-28 sm:pt-20 lg:px-8 lg:pt-24">
    <div class="subtle-grid absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl" data-reveal>
      <p class="section-eyebrow">About Hustle & Rise</p>
      <h1 class="max-w-5xl font-brand text-5xl font-extrabold leading-[1.02] tracking-[-0.065em] sm:text-6xl lg:text-7xl">A practical bridge between finding work and building a future.</h1>
      <p class="mt-7 max-w-3xl text-lg leading-8 text-[#687081] sm:text-xl">{site.description}</p>
    </div>
  </section>

  <section class="bg-[#fff1e9] px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[0.8fr_1.2fr]" data-reveal>
      <div><p class="section-eyebrow">Why it exists</p><h2 class="font-brand text-4xl font-extrabold leading-tight tracking-[-0.05em] sm:text-5xl">One journey, not six unrelated websites.</h2></div>
      <div class="space-y-5 text-lg leading-8 text-[#626b7b]"><p>People rarely need only a list of vacancies. They need help recognising a suitable opportunity, submitting a stronger application, preparing for the interview, and developing skills that improve the next opportunity too.</p><p>Hustle & Rise connects those steps while keeping advice practical, expectations honest, and the initial focus clear: New Zealand jobs and useful remote opportunities.</p></div>
    </div>
  </section>

  <section class="px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {productSections.map((section, index) => (
        <a href={section.href} class="card-hover group p-7" data-reveal={index < 3 ? `delay-${index + 1}` : undefined}>
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-[#eeeeff] font-brand text-xs font-extrabold text-[#5b5ce2]">{String(index + 1).padStart(2, "0")}</span>
          <p class="mt-7 text-xs font-bold uppercase tracking-[0.12em] text-[#ff6b35]">{section.eyebrow}</p>
          <h3 class="mt-2 font-brand text-xl font-extrabold">{section.shortTitle}</h3>
          <p class="mt-3 text-sm leading-6 text-[#687081]">{section.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
