---
import BaseLayout from "../layouts/BaseLayout.astro";
import { productSections, site } from "../config/site";
---

<BaseLayout title="About Hustle & Rise" description={site.description}>
  <section class="relative overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-28 dark-gradient">
    <div class="absolute inset-0 subtle-grid" aria-hidden="true"></div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="section-eyebrow">About Hustle & Rise</p>
      <h1 class="max-w-4xl font-serif text-4xl font-bold leading-tight sm:text-6xl">A practical bridge between finding work and building a future.</h1>
      <p class="mt-7 max-w-3xl text-lg leading-relaxed text-white/70 sm:text-xl">{site.description}</p>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="max-w-5xl mx-auto grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="section-eyebrow">Why it exists</p>
        <h2 class="font-serif text-3xl font-bold sm:text-4xl">One journey, not six unrelated websites.</h2>
      </div>
      <div class="space-y-5 text-lg leading-relaxed text-white/65">
        <p>People rarely need only a list of vacancies. They need help recognising a suitable opportunity, submitting a stronger application, preparing for the interview, and developing skills that improve the next opportunity too.</p>
        <p>Hustle & Rise connects those steps while keeping advice practical, expectations honest, and the initial focus clear: New Zealand jobs and useful remote opportunities.</p>
      </div>
    </div>

    <div class="max-w-5xl mx-auto mt-16 grid gap-px border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-3">
      {productSections.map((section) => (
        <a href={section.href} class="bg-slate-950 p-6 text-white hover:bg-white/[0.04]">
          <p class="font-brand text-xs font-bold uppercase tracking-[0.14em] text-electric">{section.eyebrow}</p>
          <h3 class="mt-3 font-serif text-xl font-bold">{section.shortTitle}</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/55">{section.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
