---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogFeedAdSlot from "../../components/BlogFeedAdSlot.astro";
import EditorialCard from "../../components/EditorialCard.astro";
import { editorialSections, getPublishedPosts } from "../../lib/content/editorial";

const posts = await getPublishedPosts();
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const featuredSection = featured ? editorialSections[featured.data.section] : null;
const sectionEntries = Object.entries(editorialSections);
const formatDate = (date: Date) => date.toLocaleDateString("en-NZ", { day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout title="Career, Interview and Earning Guides | Hustle & Rise" description="Explore practical, carefully written guides for finding work, preparing for interviews, building skills, and earning with confidence.">
  <section class="blog-hero">
    <div class="subtle-grid absolute inset-0" aria-hidden="true"></div>
    <div class="blog-orb blog-orb-one" aria-hidden="true"></div>
    <div class="blog-orb blog-orb-two" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
      <div class="max-w-4xl" data-reveal>
        <p class="section-eyebrow">The Hustle & Rise blog</p>
        <h1>Clear advice for your <span>next move.</span></h1>
        <p class="blog-intro">Practical guidance for finding work, interviewing well, building useful skills, and creating realistic ways to earn—without hype or shortcuts.</p>
        <div class="blog-proof" aria-label="Editorial principles">
          <span><i aria-hidden="true"></i><strong>Practical</strong> steps</span>
          <span><i aria-hidden="true"></i><strong>Honest</strong> expectations</span>
          <span><i aria-hidden="true"></i><strong>{posts.length}</strong> published guides</span>
        </div>
      </div>
    </div>
  </section>

  {featured && featuredSection && (
    <section class="featured-section" aria-labelledby="featured-heading">
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
        <article class="featured-story" data-reveal>
          <div class="featured-copy">
            <div class="featured-meta"><span style={`--feature-accent:${featuredSection.accent}`}>{featuredSection.label}</span><time datetime={featured.data.pubDate.toISOString()}>{formatDate(featured.data.pubDate)}</time></div>
            <p class="featured-label">Featured guide</p>
            <h2 id="featured-heading"><a href={`/blog/${featured.id}/`}>{featured.data.title}</a></h2>
            <p>{featured.data.description}</p>
            <div class="featured-footer"><span>{featured.data.readTime}</span><a class="btn-electric" href={`/blog/${featured.id}/`}>Read featured guide <span aria-hidden="true">→</span></a></div>
          </div>
          <div class="featured-visual" aria-hidden="true">
            <span class="visual-kicker">Plan • Practise • Progress</span>
            <div class="visual-sheet">
              <span>01</span><strong>Turn experience into evidence</strong>
              <i></i><i></i><i></i>
            </div>
            <div class="visual-note">Your next step<br /><strong>starts small.</strong></div>
          </div>
        </article>
      </div>
    </section>
  )}

  <section class="topic-section" aria-labelledby="topics-heading">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <div class="topic-heading" data-reveal><div><p class="section-eyebrow">Explore by goal</p><h2 id="topics-heading">Find the guidance you need.</h2></div><p>Move between focused collections without losing the bigger picture.</p></div>
      <div class="topic-grid">
        {sectionEntries.map(([key, section], index) => (
          <a class="topic-card" href={section.href} style={`--topic-accent:${section.accent}`} data-reveal>
            <span>0{index + 1}</span><i aria-hidden="true"></i><h3>{section.label}</h3><p>{key === "interview" ? "Build answers and confidence before the conversation." : key === "career" ? "Strengthen your CV, applications, and direction." : key === "side-hustles" ? "Test realistic earning ideas around work or study." : key === "money" ? "Make calmer, better-informed everyday decisions." : "Use practical systems and resources that save time."}</p><strong>Explore section →</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="library-section" aria-labelledby="library-heading">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <div class="library-title" data-reveal><div><p class="section-eyebrow">Latest from the library</p><h2 id="library-heading">Guides worth acting on.</h2></div><p id="article-count" role="status" aria-live="polite">{posts.length} guides</p></div>

      <div class="section-browser" aria-label="Filter guides by topic">
        <button class="is-active" type="button" data-section-filter="" aria-pressed="true" aria-controls="editorial-results">All guides</button>
        {sectionEntries.map(([key, section]) => <button type="button" data-section-filter={key} aria-pressed="false" aria-controls="editorial-results"><i style={`--dot:${section.accent}`} aria-hidden="true"></i>{section.label}</button>)}
      </div>

      <BlogFeedAdSlot />

      {posts.length ? (
        <>
          <div class="library-grid" id="editorial-results">{posts.map((post) => <div data-editorial-card data-section={post.data.section}><EditorialCard post={post} /></div>)}</div>
          <div class="library-empty" id="library-empty" hidden><h2>No guides in this section yet.</h2><p>We publish useful work carefully rather than filling empty categories.</p></div>
        </>
      ) : <div class="library-empty"><h2>No guides published yet.</h2><p>Check back soon for practical career and earning guidance.</p></div>}
    </div>
  </section>

  <section class="editorial-promise" aria-labelledby="promise-heading">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-14 sm:px-6 lg:grid-cols-[1fr_auto] lg:items-center lg:px-8 lg:py-20">
      <div><p class="section-eyebrow">Our editorial promise</p><h2 id="promise-heading">Useful first. Transparent always.</h2><p>We aim for practical, original guidance, label commercial relationships, and separate advertising from editorial recommendations and job actions.</p></div>
      <div class="promise-links"><a href="/about">How we help</a><a href="/disclaimer">Read our disclaimer</a><a href="/affiliate-disclosure">Affiliate disclosure</a></div>
    </div>
  </section>

  <script>
    const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-section-filter]")];
    const cards = [...document.querySelectorAll<HTMLElement>("[data-editorial-card]")];
    const count = document.querySelector<HTMLElement>("#article-count");
    const empty = document.querySelector<HTMLElement>("#library-empty");
    const showSection = (section: string) => {
      let shown = 0;
      cards.forEach((card) => { card.hidden = Boolean(section && card.dataset.section !== section); if (!card.hidden) shown += 1; });
      buttons.forEach((button) => { const active = button.dataset.sectionFilter === section; button.classList.toggle("is-active", active); button.setAttribute("aria-pressed", String(active)); });
      if (count) count.textContent = `${shown} ${shown === 1 ? "guide" : "guides"}`;
      empty?.toggleAttribute("hidden", shown !== 0);
      history.replaceState(null, "", section ? `${location.pathname}?section=${encodeURIComponent(section)}` : location.pathname);
    };
    buttons.forEach((button) => button.addEventListener("click", () => showSection(button.dataset.sectionFilter ?? "")));
    const requested = new URLSearchParams(location.search).get("section") ?? "";
    showSection(buttons.some((button) => button.dataset.sectionFilter === requested) ? requested : "");
  </script>
</BaseLayout>

<style>
  .blog-hero{position:relative;overflow:hidden;background:linear-gradient(135deg,#fff7f1 0%,#fbfaf7 55%,#eeeeff 100%)}
  .blog-hero h1{position:relative;z-index:1;max-width:56rem;margin:0;font-size:clamp(3rem,7vw,6.2rem);font-weight:800;line-height:.96;letter-spacing:-.065em}.blog-hero h1 span{color:var(--orange)}
  .blog-intro{position:relative;z-index:1;max-width:45rem;margin:1.6rem 0 0;color:var(--ink-soft);font-size:1.08rem;line-height:1.75}
  .blog-proof{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:.75rem 1.6rem;margin-top:2rem;color:#616a7b;font-size:.82rem;font-weight:650}.blog-proof i{display:inline-block;width:.5rem;height:.5rem;margin-right:.35rem;border-radius:50%;background:var(--aqua);box-shadow:0 0 0 5px rgba(35,185,179,.11)}.blog-proof strong{color:var(--ink)}
  .blog-orb{position:absolute;border-radius:50%}.blog-orb-one{right:6%;bottom:-9rem;width:27rem;height:27rem;border:5rem solid rgba(255,107,53,.075)}.blog-orb-two{top:-6rem;right:32%;width:13rem;height:13rem;background:rgba(91,92,226,.07)}
  .featured-section{background:#fbfaf7}.featured-story{display:grid;overflow:hidden;border:1px solid rgba(23,32,51,.08);border-radius:2rem;background:#fff;box-shadow:0 25px 70px rgba(31,37,54,.1)}.featured-copy{padding:2rem}.featured-meta{display:flex;align-items:center;justify-content:space-between;gap:1rem}.featured-meta span{color:var(--feature-accent);font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.featured-meta time{color:#7a8290;font-size:.72rem}.featured-label{margin:3.5rem 0 .7rem!important;color:var(--orange)!important;font-size:.72rem!important;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.featured-copy h2{max-width:42rem;margin:0;font-size:clamp(2rem,4vw,3.5rem);line-height:1.08;letter-spacing:-.045em}.featured-copy h2 a:hover{color:var(--blue)}.featured-copy>p{max-width:44rem;margin:1.2rem 0 0;color:var(--ink-soft);font-size:1rem;line-height:1.75}.featured-footer{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:2rem}.featured-footer>span{color:#78808f;font-size:.75rem}
  .featured-visual{position:relative;display:none;min-height:30rem;overflow:hidden;background:linear-gradient(145deg,#5b5ce2,#4041b7)}.featured-visual::before{position:absolute;inset:-15%;background:radial-gradient(circle at 70% 20%,rgba(255,255,255,.2),transparent 24%),radial-gradient(circle at 20% 80%,rgba(35,185,179,.45),transparent 25%);content:""}.visual-kicker{position:absolute;top:2.2rem;left:2.2rem;color:rgba(255,255,255,.7);font-size:.68rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.visual-sheet{position:absolute;top:7rem;right:-1rem;width:78%;padding:1.8rem;border-radius:1.5rem 0 0 1.5rem;background:#fff;box-shadow:0 25px 60px rgba(18,20,70,.28);transform:rotate(-3deg)}.visual-sheet span{color:var(--orange);font-size:.7rem;font-weight:800}.visual-sheet strong{display:block;margin:.8rem 0 1.4rem;font-size:1.3rem;line-height:1.3}.visual-sheet i{display:block;width:100%;height:.5rem;margin:.7rem 0;border-radius:99px;background:#eeeeff}.visual-sheet i:nth-of-type(2){width:78%}.visual-sheet i:nth-of-type(3){width:55%;background:#fff0e8}.visual-note{position:absolute;bottom:2.5rem;left:2rem;padding:1rem 1.2rem;border:1px solid rgba(255,255,255,.22);border-radius:1rem;background:rgba(255,255,255,.12);color:#fff;font-size:.82rem;line-height:1.5;backdrop-filter:blur(8px)}
  .topic-section{background:#f1f0ec}.topic-heading,.library-title{display:flex;align-items:end;justify-content:space-between;gap:2rem}.topic-heading h2,.library-title h2,.editorial-promise h2{margin:0;font-size:clamp(2rem,4vw,3.4rem)}.topic-heading>p{max-width:24rem;margin:0;color:var(--ink-soft);font-size:.9rem;line-height:1.65}.topic-grid{display:grid;gap:1rem;margin-top:2rem}.topic-card{position:relative;display:flex;min-height:16rem;flex-direction:column;padding:1.5rem;border:1px solid rgba(23,32,51,.07);border-radius:1.4rem;background:#fff;box-shadow:var(--shadow-sm);transition:transform .25s ease,box-shadow .25s ease}.topic-card:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg)}.topic-card>span{color:#9298a4;font-size:.68rem;font-weight:800}.topic-card>i{width:2.2rem;height:.28rem;margin:1.1rem 0;border-radius:99px;background:var(--topic-accent)}.topic-card h3{margin:0;font-size:1.15rem}.topic-card p{margin:.65rem 0 1.2rem;color:#687182;font-size:.82rem;line-height:1.65}.topic-card strong{margin-top:auto;color:var(--topic-accent);font-size:.73rem}
  .library-section{background:#fbfaf7}.library-title>p{margin:0;color:#7a8290;font-size:.8rem}.section-browser{display:flex;gap:.65rem;margin:2rem 0 1.5rem;padding-bottom:.5rem;overflow-x:auto}.section-browser button{display:inline-flex;flex:none;align-items:center;gap:.45rem;padding:.72rem 1rem;border:1px solid #dcdad3;border-radius:999px;background:#fff;color:#667082;font:inherit;font-size:.75rem;font-weight:750;cursor:pointer}.section-browser button.is-active{border-color:var(--ink);background:var(--ink);color:#fff}.section-browser button:focus-visible{outline:3px solid var(--orange);outline-offset:3px}.section-browser i{width:.5rem;height:.5rem;border-radius:50%;background:var(--dot)}.library-grid{display:grid;gap:1.2rem}.library-grid>[hidden]{display:none}.library-empty{padding:4rem 1rem;text-align:center}.library-empty[hidden]{display:none}.library-empty h2{margin:0}.library-empty p{color:var(--ink-soft)}
  .editorial-promise{background:#172033;color:#fff}.editorial-promise h2{color:#fff}.editorial-promise p:not(.section-eyebrow){max-width:48rem;margin:1rem 0 0;color:rgba(255,255,255,.68);line-height:1.75}.promise-links{display:flex;flex-wrap:wrap;gap:.65rem}.promise-links a{padding:.75rem 1rem;border:1px solid rgba(255,255,255,.18);border-radius:999px;color:#fff;font-size:.74rem;font-weight:750;transition:background .2s ease}.promise-links a:hover{background:rgba(255,255,255,.1)}
  @media(min-width:640px){.topic-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.library-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.featured-copy{padding:3rem}}
  @media(min-width:900px){.featured-story{grid-template-columns:minmax(0,1.35fr) minmax(20rem,.65fr)}.featured-visual{display:block}}
  @media(min-width:1024px){.topic-grid{grid-template-columns:repeat(5,minmax(0,1fr))}.library-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:639px){.topic-heading,.library-title{align-items:flex-start;flex-direction:column;gap:.8rem}.featured-footer{align-items:flex-start;flex-direction:column}.featured-footer .btn-electric{width:100%;justify-content:center}.promise-links{display:grid}}
</style>
