---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const sortedPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Practical Guides | Hustle & Rise" description="Practical career, interview, skills, and earning guides from Hustle & Rise.">
  <section class="relative overflow-hidden px-4 pb-20 pt-16 sm:px-6 sm:pb-24 sm:pt-20 lg:px-8 lg:pt-24">
    <div class="subtle-grid absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl text-center" data-reveal>
      <p class="section-eyebrow">Practical library</p>
      <h1 class="mx-auto max-w-4xl font-brand text-5xl font-extrabold leading-[1.02] tracking-[-0.065em] sm:text-6xl lg:text-7xl">Useful ideas for your next move.</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-[#687081]">{sortedPosts.length} honest, actionable guides—written to help you make progress, not chase hype.</p>
    </div>
  </section>

  <section class="bg-[#f1f3f8] px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      {sortedPosts.length === 0 ? (
        <div class="rounded-[2rem] bg-white py-20 text-center shadow-sm"><p class="text-lg text-[#687081]">No guides published yet. Check back soon.</p></div>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {sortedPosts.map((post, index) => (
            <article class="group flex min-h-[22rem] flex-col overflow-hidden rounded-[1.75rem] border border-black/[0.06] bg-white shadow-[0_12px_35px_rgba(31,37,54,0.06)] transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_25px_60px_rgba(31,37,54,0.12)]" data-reveal={index < 3 ? `delay-${index + 1}` : undefined}>
              {post.data.heroImage && <a href={`/blog/${post.id}`} class="block h-52 overflow-hidden"><img src={post.data.heroImage} alt={post.data.title} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" /></a>}
              <div class="flex flex-1 flex-col p-7">
                <div class="flex items-center justify-between gap-3"><span class="category-badge">{post.data.category}</span><span class="text-xs text-[#8b91a0]">{post.data.readTime}</span></div>
                <h2 class="mt-6 font-brand text-xl font-extrabold leading-snug"><a href={`/blog/${post.id}`} class="transition-colors group-hover:text-[#5b5ce2]">{post.data.title}</a></h2>
                <p class="mt-3 line-clamp-3 text-sm leading-6 text-[#727a8a]">{post.data.description}</p>
                <div class="mt-auto flex items-end justify-between border-t border-black/[0.06] pt-6">
                  <div><span class="block text-xs font-bold text-[#4d5669]">{post.data.author}</span><time datetime={post.data.pubDate.toISOString()} class="mt-1 block text-xs text-[#9399a6]">{post.data.pubDate.toLocaleDateString("en-NZ", { month: "short", day: "numeric", year: "numeric" })}</time></div>
                  <a href={`/blog/${post.id}`} class="text-sm font-bold text-[#5b5ce2]">Read ↗</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
