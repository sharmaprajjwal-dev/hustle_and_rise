---
import BaseLayout from "./BaseLayout.astro";
import ShareButtons from "../components/ShareButtons.astro";
import HustlerTakeaway from "../components/HustlerTakeaway.astro";
import FunnelCTA from "../components/FunnelCTA.astro";

export interface Props {
  title: string;
  description: string;
  pubDate: string;
  updatedDate?: string;
  heroImage?: string;
  category?: string;
  author?: string;
  readTime?: string;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, heroImage, category = "Digital Income", author = "Hustle & Rise Team", readTime = "5 min read", tags = [] } = Astro.props;
const formattedDate = new Date(pubDate).toLocaleDateString("en-NZ", { year: "numeric", month: "long", day: "numeric" });
const formattedUpdated = updatedDate ? new Date(updatedDate).toLocaleDateString("en-NZ", { year: "numeric", month: "long", day: "numeric" }) : null;
---

<BaseLayout title={`${title} | Hustle & Rise`} description={description} image={heroImage}>
  <section class="relative overflow-hidden px-4 pb-16 pt-14 sm:px-6 sm:pb-20 sm:pt-20 lg:px-8">
    <div class="subtle-grid absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-5xl text-center" data-reveal>
      <span class="category-badge">{category}</span>
      <h1 class="mx-auto mt-6 max-w-5xl font-brand text-4xl font-extrabold leading-[1.06] tracking-[-0.06em] sm:text-5xl lg:text-6xl">{title}</h1>
      <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-[#687081]">{description}</p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-3 text-sm text-[#7a8292]">
        <span class="grid h-9 w-9 place-items-center rounded-full bg-[#eeeeff] font-bold text-[#5b5ce2]">{author.charAt(0)}</span>
        <strong class="text-[#3f485b]">{author}</strong><span>•</span><time datetime={pubDate}>{formattedDate}</time>{formattedUpdated && <><span>•</span><span>Updated {formattedUpdated}</span></>}<span>•</span><span>{readTime}</span>
      </div>
    </div>
  </section>

  {heroImage && <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8" data-reveal><img src={heroImage} alt={title} class="max-h-[36rem] w-full rounded-[2rem] object-cover shadow-[0_28px_80px_rgba(31,37,54,0.13)]" loading="eager" /></div>}

  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-14 xl:gap-20">
      <article class="min-w-0">
        <ShareButtons title={title} />
        <div class="prose prose-lg max-w-none
          prose-headings:font-brand prose-headings:font-extrabold prose-headings:tracking-[-0.04em] prose-headings:text-[#172033]
          prose-h2:mt-12 prose-h2:text-3xl prose-h3:mt-9 prose-h3:text-2xl
          prose-p:text-[#566071] prose-p:leading-8
          prose-a:text-[#5b5ce2] prose-a:font-semibold prose-a:no-underline hover:prose-a:underline
          prose-strong:text-[#252f43]
          prose-blockquote:rounded-r-2xl prose-blockquote:border-[#ff6b35] prose-blockquote:bg-[#fff1e9] prose-blockquote:px-6 prose-blockquote:py-2 prose-blockquote:not-italic prose-blockquote:text-[#4d5669]
          prose-code:rounded prose-code:bg-[#eeeeff] prose-code:px-1.5 prose-code:py-0.5 prose-code:text-[#4b4cc8]
          prose-pre:border prose-pre:border-black/10 prose-pre:bg-[#172033]
          prose-li:marker:text-[#ff6b35] prose-li:text-[#566071]
          prose-hr:border-black/10">
          <slot />
        </div>

        {tags.length > 0 && <div class="mt-12 flex flex-wrap items-center gap-2 border-t border-black/[0.07] pt-7"><span class="mr-1 text-xs font-bold uppercase tracking-[0.12em] text-[#8a91a0]">Tags</span>{tags.map((tag) => <span class="rounded-full border border-black/10 bg-white px-3 py-1.5 text-xs font-semibold text-[#687081]">{tag}</span>)}</div>}

        <div class="mt-10 flex gap-4 rounded-[1.5rem] border border-black/[0.06] bg-white p-6 shadow-sm sm:p-8">
          <div class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-[#5b5ce2] text-lg font-bold text-white">{author.charAt(0)}</div>
          <div><p class="text-xs font-bold uppercase tracking-[0.12em] text-[#ff6b35]">Written by</p><h2 class="mt-1 font-brand text-xl font-extrabold">{author}</h2><p class="mt-2 text-sm leading-6 text-[#687081]">The Hustle & Rise team creates practical resources for students, job seekers, and early-career people.</p></div>
        </div>

        <HustlerTakeaway class="mt-10"><p><strong>Remember:</strong> Start small, test what works, and keep building from evidence—not hype.</p></HustlerTakeaway>
      </article>

      <aside class="mt-12 lg:mt-0">
        <div class="sticky top-28 rounded-[1.5rem] border border-black/[0.06] bg-white p-6 shadow-sm">
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-[#ff6b35]">Keep moving</p>
          <h2 class="mt-3 font-brand text-xl font-extrabold">More practical guidance</h2>
          <p class="mt-3 text-sm leading-6 text-[#687081]">Explore career, interview, skills, and earning resources from one connected library.</p>
          <a href="/blog" class="btn-outline-electric mt-6 w-full text-center">All guides</a>
        </div>
      </aside>
    </div>
  </div>

  <FunnelCTA />
  <div class="border-t border-black/[0.06] px-4 py-8 sm:px-6"><div class="mx-auto flex max-w-4xl flex-col justify-between gap-4 sm:flex-row"><a href="/blog" class="text-sm font-bold text-[#5b5ce2]">← Back to all guides</a><a href="/" class="text-sm font-bold text-[#5b5ce2]">Home →</a></div></div>
</BaseLayout>
