---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import AdNetworkLoader from "../components/AdNetworkLoader.astro";
import AnalyticsHooks from "../components/AnalyticsHooks.astro";
import SavedJobsController from "../components/SavedJobsController.astro";
import { navigation, site } from "../config/site";
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/client";
import { Bookmark } from "@lucide/astro";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  pageType?: "website" | "article";
}

const { title, description = site.description, image = "/og.png", imageAlt = "Hustle & Rise — Find Work. Build Skills. Earn More.", noindex = false, pageType = "website" } = Astro.props;
const rawPath = Astro.url.pathname;
const canonicalPath = rawPath === "/" || rawPath.endsWith("/") || rawPath.includes(".") ? rawPath : `${rawPath}/`;
const canonicalURL = new URL(canonicalPath, Astro.site ?? site.domain);
const socialImage = new URL(image, Astro.site ?? site.domain);
const currentPath = Astro.url.pathname;
const websiteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": `${site.domain}/#organization`, name: site.name, url: site.domain, logo: new URL("/icon-192.png", site.domain).toString(), email: site.email },
    { "@type": "WebSite", "@id": `${site.domain}/#website`, url: site.domain, name: site.name, description: site.description, publisher: { "@id": `${site.domain}/#organization` }, inLanguage: "en-NZ" },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fbfaf7" />
    <meta name="color-scheme" content="light" />
    <meta name="author" content="Hustle & Rise" />
    {PUBLIC_GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={PUBLIC_GOOGLE_SITE_VERIFICATION} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={pageType} />
    <meta property="og:locale" content="en_NZ" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <AdNetworkLoader />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <div class="site-shell">
      <header class="site-header" id="main-header">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="flex h-[4.5rem] items-center justify-between lg:h-20">
            <a href="/" class="flex items-center gap-2.5" aria-label="Hustle & Rise home">
              <Logo size="h-10 w-10 lg:h-11 lg:w-11" />
              <span class="brand-wordmark">Hustle <span>&</span> Rise</span>
            </a>

            <nav class="hidden items-center gap-5 xl:gap-7 lg:flex" aria-label="Primary navigation">
              {navigation.map((item) => (
                <a
                  href={item.href}
                  class:list={["nav-link", currentPath.startsWith(item.href) && "is-active"]}
                  aria-current={currentPath.startsWith(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))}
            </nav>

            <div class="flex items-center gap-2.5">
              <a href="/saved-jobs" class="hidden min-h-10 items-center gap-1.5 rounded-full border border-black/10 bg-white px-3 text-xs font-bold text-[#596274] transition-colors hover:border-[#5b5ce2]/30 hover:text-[#5b5ce2] xl:inline-flex" aria-label="View saved jobs">
                <Bookmark size={16} stroke-width={2} /><span>Saved</span><b class="grid min-w-5 place-items-center rounded-full bg-[#eeeeff] px-1 text-[0.65rem] text-[#5b5ce2]" data-saved-jobs-count>0</b>
              </a>
              <a href="/jobs" class="btn-electric compact hidden sm:inline-flex">Explore opportunities <span aria-hidden="true">↗</span></a>
              <button
                id="mobile-menu-btn"
                class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-black/10 bg-white text-[#172033] lg:hidden"
                type="button"
                aria-label="Open menu"
                aria-controls="mobile-menu"
                aria-expanded="false"
              >
                <span class="text-xl leading-none" aria-hidden="true">☰</span>
              </button>
            </div>
          </div>
        </div>

        <div id="mobile-menu" class="hidden border-t border-black/5 bg-white lg:hidden">
          <nav class="mx-auto grid max-w-7xl px-4 py-4 sm:px-6" aria-label="Mobile navigation">
            {navigation.map((item) => (
              <a href={item.href} class="mobile-nav-link" aria-current={currentPath.startsWith(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))}
            <a href="/about" class="mobile-nav-link">About Hustle & Rise</a>
            <a href="/saved-jobs" class="mobile-nav-link flex items-center justify-between"><span>Saved jobs</span><b class="grid min-w-6 place-items-center rounded-full bg-[#eeeeff] px-1.5 text-xs text-[#5b5ce2]" data-saved-jobs-count>0</b></a>
          </nav>
        </div>
      </header>

      <main id="main-content">
        <slot />
      </main>

      <footer class="site-footer relative overflow-hidden pb-8 pt-16 text-[#172033] sm:pt-20">
        <div class="absolute -right-24 -top-28 h-80 w-80 rounded-full bg-[#5b5ce2]/[0.07]" aria-hidden="true"></div>
        <div class="absolute -bottom-40 -left-32 h-80 w-80 rounded-full bg-[#ff6b35]/[0.06] blur-2xl" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="footer-cta mb-14 grid gap-8 rounded-[2rem] p-7 sm:grid-cols-[1fr_auto] sm:items-center sm:p-10">
            <div>
              <p class="font-brand text-xs font-bold uppercase tracking-[0.14em] text-white/75">Your next move starts here</p>
              <h2 class="mt-2 max-w-2xl font-brand text-2xl font-bold tracking-[-0.04em] text-white sm:text-3xl">Find clearer pathways to work, skills, and income.</h2>
            </div>
            <a href="/career" class="inline-flex min-h-12 items-center justify-center rounded-full bg-white px-6 font-brand text-sm font-bold text-[#172033] transition-transform hover:-translate-y-1">Explore your pathway <span class="ml-2" aria-hidden="true">→</span></a>
          </div>

          <div class="grid gap-10 border-b border-black/[0.09] pb-12 md:grid-cols-[1.25fr_2fr]">
            <div>
              <a href="/" class="mb-5 inline-flex items-center gap-3 text-[#172033]">
                <Logo size="h-12 w-12" />
                <span class="font-brand font-extrabold tracking-[-0.03em]">Hustle & Rise</span>
              </a>
              <p class="max-w-md text-sm leading-relaxed text-[#616a7b]">{site.description}</p>
              <p class="mt-5 text-sm font-semibold text-[#e95420]">{site.tagline}</p>
            </div>

            <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
              <div>
                <h2 class="footer-heading">Find work</h2>
                <ul class="footer-links">
                  {navigation.slice(0, 3).map((item) => <li><a href={item.href}>{item.label}</a></li>)}
                </ul>
              </div>
              <div>
                <h2 class="footer-heading">Build & earn</h2>
                <ul class="footer-links">
                  {navigation.slice(3).map((item) => <li><a href={item.href}>{item.label}</a></li>)}
                </ul>
              </div>
              <div>
                <h2 class="footer-heading">Hustle & Rise</h2>
                <ul class="footer-links">
                  <li><a href="/about">About</a></li>
                  <li><a href="/contact">Contact</a></li>
                  <li><a href="/privacy">Privacy</a></li>
                  <li><a href="/terms">Terms</a></li>
                  <li><a href="/disclaimer">Disclaimer</a></li>
                  <li><a href="/affiliate-disclosure">Affiliate disclosure</a></li>
                </ul>
              </div>
            </div>
          </div>

          <div class="flex flex-col gap-3 pt-7 text-xs text-[#727a89] sm:flex-row sm:items-center sm:justify-between">
            <p>&copy; {new Date().getFullYear()} Hustle & Rise. All rights reserved.</p>
            <p>General career and earning guidance—not financial or legal advice.</p>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const menuButton = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      const header = document.getElementById("main-header");

      const closeMenu = () => {
        mobileMenu?.classList.add("hidden");
        menuButton?.setAttribute("aria-expanded", "false");
        menuButton?.setAttribute("aria-label", "Open menu");
        const icon = menuButton?.querySelector("span");
        if (icon) icon.textContent = "☰";
      };

      menuButton?.addEventListener("click", () => {
        const willOpen = mobileMenu?.classList.contains("hidden") ?? false;
        mobileMenu?.classList.toggle("hidden");
        menuButton.setAttribute("aria-expanded", String(willOpen));
        menuButton.setAttribute("aria-label", willOpen ? "Close menu" : "Open menu");
        const icon = menuButton.querySelector("span");
        if (icon) icon.textContent = willOpen ? "×" : "☰";
      });

      mobileMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));

      const updateHeader = () => header?.classList.toggle("is-scrolled", window.scrollY > 12);
      updateHeader();
      window.addEventListener("scroll", updateHeader, { passive: true });

      const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });
        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      }
    </script>
    <AnalyticsHooks />
    <SavedJobsController />
  </body>
</html>
