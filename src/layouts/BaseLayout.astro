---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { navigation, site } from "../config/site";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? site.domain);
const socialImage = image ? new URL(image, Astro.site ?? site.domain) : null;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {socialImage && <meta property="og:image" content={socialImage} />}

    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-slate-950/95 backdrop-blur" id="main-header">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between lg:h-20">
          <a href="/" class="flex items-center gap-3 text-white" aria-label="Hustle & Rise home">
            <Logo size="w-11 h-11 lg:w-12 lg:h-12" />
            <span class="hidden font-brand text-sm font-bold tracking-[0.12em] sm:inline">HUSTLE & RISE</span>
          </a>

          <nav class="hidden items-center gap-5 lg:flex" aria-label="Primary navigation">
            {navigation.map((item) => (
              <a
                href={item.href}
                class:list={["nav-link", currentPath.startsWith(item.href) && "is-active"]}
                aria-current={currentPath.startsWith(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>

          <div class="flex items-center gap-3">
            <a href="/jobs" class="hidden btn-electric compact sm:inline-flex">Find jobs</a>
            <button
              id="mobile-menu-btn"
              class="inline-flex items-center justify-center p-2 text-white lg:hidden"
              type="button"
              aria-label="Open menu"
              aria-controls="mobile-menu"
              aria-expanded="false"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div id="mobile-menu" class="hidden border-t border-white/10 bg-slate-950 lg:hidden">
        <nav class="grid max-w-7xl gap-1 px-4 py-4 sm:px-6" aria-label="Mobile navigation">
          {navigation.map((item) => (
            <a href={item.href} class="mobile-nav-link" aria-current={currentPath.startsWith(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))}
          <a href="/about" class="mobile-nav-link">About Hustle & Rise</a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="border-t border-white/10 bg-slate-950 pb-8 pt-14 text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 border-b border-white/10 pb-12 md:grid-cols-[1.4fr_2fr]">
          <div>
            <a href="/" class="mb-4 inline-flex items-center gap-3 text-white">
              <Logo size="w-11 h-11" />
              <span class="font-brand font-bold tracking-[0.12em]">HUSTLE & RISE</span>
            </a>
            <p class="max-w-md text-sm leading-relaxed text-white/60">{site.description}</p>
            <p class="mt-4 font-brand text-xs font-bold uppercase tracking-[0.16em] text-electric">{site.tagline}</p>
          </div>

          <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
            <div>
              <h2 class="footer-heading">Explore</h2>
              <ul class="footer-links">
                {navigation.slice(0, 3).map((item) => <li><a href={item.href}>{item.label}</a></li>)}
              </ul>
            </div>
            <div>
              <h2 class="footer-heading">Build & earn</h2>
              <ul class="footer-links">
                {navigation.slice(3).map((item) => <li><a href={item.href}>{item.label}</a></li>)}
              </ul>
            </div>
            <div>
              <h2 class="footer-heading">Company</h2>
              <ul class="footer-links">
                <li><a href="/about">About</a></li>
                <li><a href="/contact">Contact</a></li>
                <li><a href="/privacy">Privacy</a></li>
                <li><a href="/terms">Terms</a></li>
              </ul>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-3 pt-7 text-xs text-white/40 sm:flex-row sm:items-center sm:justify-between">
          <p>&copy; {new Date().getFullYear()} Hustle & Rise. All rights reserved.</p>
          <p>Career and earning information is general guidance, not financial or legal advice.</p>
        </div>
      </div>
    </footer>

    <script>
      const menuButton = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");

      const closeMenu = () => {
        mobileMenu?.classList.add("hidden");
        menuButton?.setAttribute("aria-expanded", "false");
        menuButton?.setAttribute("aria-label", "Open menu");
      };

      menuButton?.addEventListener("click", () => {
        const willOpen = mobileMenu?.classList.contains("hidden") ?? false;
        mobileMenu?.classList.toggle("hidden");
        menuButton.setAttribute("aria-expanded", String(willOpen));
        menuButton.setAttribute("aria-label", willOpen ? "Close menu" : "Open menu");
      });

      mobileMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
    </script>
  </body>
</html>
