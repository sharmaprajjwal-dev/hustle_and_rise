---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Compass, FileText, GraduationCap, Lightbulb } from "@lucide/astro";

interface Item { title: string; description: string; }
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  items: Item[];
  note?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { eyebrow, title, description, items, note, ctaLabel, ctaHref } = Astro.props;
const accents = [
  "bg-[#fff0e8] text-[#ff6b35]",
  "bg-[#eeeeff] text-[#5b5ce2]",
  "bg-[#eafaf8] text-[#168985]",
  "bg-[#fff7dc] text-[#b87412]",
];
const itemIcons = [Compass, FileText, GraduationCap, Lightbulb];
---

<BaseLayout title={`${title} | Hustle & Rise`} description={description}>
  <section class="relative overflow-hidden px-4 pb-20 pt-16 sm:px-6 sm:pb-24 sm:pt-20 lg:px-8 lg:pb-28 lg:pt-24">
    <div class="subtle-grid absolute inset-0" aria-hidden="true"></div>
    <div class="absolute -right-32 top-4 h-96 w-96 rounded-full bg-[#ff6b35]/10 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl text-center" data-reveal>
      <p class="section-eyebrow">{eyebrow}</p>
      <h1 class="mx-auto max-w-5xl font-brand text-5xl font-extrabold leading-[1.02] tracking-[-0.065em] sm:text-6xl lg:text-7xl">{title}</h1>
      <p class="mx-auto mt-7 max-w-3xl text-lg leading-8 text-[#687081] sm:text-xl">{description}</p>
      {ctaLabel && ctaHref && <a href={ctaHref} class="btn-electric mt-8">{ctaLabel} <span aria-hidden="true">→</span></a>}
    </div>
  </section>

  <section class="px-4 pb-20 sm:px-6 sm:pb-28 lg:px-8">
    <div class="mx-auto max-w-6xl">
      {note && (
        <div class="mb-8 flex items-start gap-3 rounded-2xl border border-[#23b9b3]/15 bg-[#eafaf8] p-4 text-sm leading-6 text-[#4f6867]" data-reveal>
          <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-[#23b9b3] text-xs font-bold text-white">i</span>
          <p>{note}</p>
        </div>
      )}

      <div class="grid gap-5 sm:grid-cols-2">
        {items.map((item, index) => {
          const Icon = itemIcons[index % itemIcons.length];
          return (
          <article class="card-hover group p-7 sm:p-9" data-reveal={index < 3 ? `delay-${index + 1}` : undefined}>
            <div class="flex items-center justify-between">
              <span class:list={["grid h-13 w-13 place-items-center rounded-2xl transition-transform group-hover:rotate-[-4deg] group-hover:scale-105", accents[index % accents.length]]}><Icon size={24} stroke-width={1.9} /></span>
              <span class="text-xl text-[#b4b8c2] transition-transform group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-[#ff6b35]" aria-hidden="true">↗</span>
            </div>
            <p class="mt-7 font-brand text-[0.68rem] font-extrabold tracking-[0.12em] text-[#9a9fab]">{String(index + 1).padStart(2, "0")}</p>
            <h2 class="mt-2 font-brand text-2xl font-extrabold tracking-[-0.04em] sm:text-3xl">{item.title}</h2>
            <p class="mt-3 max-w-xl leading-7 text-[#687081]">{item.description}</p>
          </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
