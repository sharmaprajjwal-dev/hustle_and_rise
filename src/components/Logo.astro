---
interface Props {
  size?: string;
  class?: string;
}

const { size = "h-9 w-9", class: additionalClass = "" } = Astro.props;
---

<img
  src="/brand/hustle-rise-mark-256.png"
  width="256"
  height="256"
  alt=""
  class:list={[size, additionalClass, "shrink-0 object-contain"]}
  decoding="async"
/>
