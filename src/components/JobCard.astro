---
import type { ListedJob } from "../lib/jobs/queries.server";
import { formatJobType, formatPostedDate, formatSalary } from "../lib/jobs/queries.server";
import SaveJobButton from "./SaveJobButton.astro";

interface Props {
  job: ListedJob;
}

const { job } = Astro.props;
const initial = (job.company ?? job.title).charAt(0).toUpperCase();
const type = formatJobType(job.job_type);
const date = formatPostedDate(job.published_at);
const salary = formatSalary(job);
const searchValue = [job.title, job.company, job.location, job.category, type].filter(Boolean).join(" ").toLowerCase();
---

<article
  class="job-card"
  data-job-card
  data-search={searchValue}
  data-location={(job.location ?? "").toLowerCase()}
  data-type={(job.job_type ?? "").toLowerCase()}
  data-category={(job.category ?? "").toLowerCase()}
  data-remote={job.remote_type === "remote" ? "true" : "false"}
  data-published={job.published_at ?? ""}
>
  <div class="job-card-topline">
    <div class="job-company-mark" aria-hidden="true">{initial}</div>
    <div class="job-card-actions"><span class="job-source">From {job.sourceName}</span>{job.slug && <SaveJobButton slug={job.slug} title={job.title} />}</div>
  </div>
  <div>
    <h2><a href={`/jobs/${job.slug}/`}>{job.title}</a></h2>
    {job.company && <p class="job-company">{job.company}</p>}
  </div>
  <dl class="job-meta">
    {job.location && <div><dt class="sr-only">Location</dt><dd>⌖ {job.location}</dd></div>}
    {type && <div><dt class="sr-only">Job type</dt><dd>◷ {type}</dd></div>}
    {salary && <div><dt class="sr-only">Salary</dt><dd>◇ {salary}</dd></div>}
    {date && <div><dt class="sr-only">Posted</dt><dd>Posted {date}</dd></div>}
  </dl>
  <div class="job-card-footer">
    {job.category && <span class="job-category">{job.category}</span>}
    <a class="job-view-link" href={`/jobs/${job.slug}/`} aria-label={`View ${job.title} at ${job.company ?? "this employer"}`}>View role <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .job-card { display:flex; min-height:22rem; flex-direction:column; gap:1.25rem; padding:1.5rem; border:1px solid rgba(23,32,51,.09); border-radius:1.5rem; background:#fff; box-shadow:0 12px 34px rgba(30,38,57,.07); transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease; }
  .job-card:hover { transform:translateY(-5px); border-color:rgba(91,92,226,.28); box-shadow:0 24px 55px rgba(30,38,57,.12); }
  .job-card[hidden] { display:none; }
  .job-card-topline,.job-card-footer { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
  .job-card-actions { display:flex; align-items:center; gap:.55rem; }
  .job-company-mark { display:grid; width:3rem; height:3rem; place-items:center; border-radius:1rem; background:linear-gradient(135deg,#eeeeff,#fff0e8); color:#5b5ce2; font-family:var(--font-brand); font-size:1.05rem; font-weight:800; }
  .job-source { color:#7a8190; font-size:.72rem; font-weight:650; }
  h2 { margin:0; font-size:1.18rem; line-height:1.3; }
  h2 a:hover { color:var(--blue); }
  .job-company { margin:.45rem 0 0; color:var(--ink-soft); font-size:.9rem; font-weight:600; }
  .job-meta { display:grid; gap:.65rem; margin:0; color:#626b7c; font-size:.82rem; }
  .job-meta div,.job-meta dd { margin:0; }
  .job-card-footer { margin-top:auto; padding-top:1rem; border-top:1px solid var(--line); }
  .job-category { overflow:hidden; max-width:60%; padding:.4rem .65rem; border-radius:999px; background:var(--orange-soft); color:var(--orange-dark); font-size:.65rem; font-weight:750; text-overflow:ellipsis; white-space:nowrap; }
  .job-view-link { color:var(--blue); font-family:var(--font-brand); font-size:.78rem; font-weight:800; }
  .job-view-link span { transition:transform .2s ease; }
  .job-view-link:hover span { display:inline-block; transform:translateX(3px); }
</style>
