---
import { Bookmark } from "@lucide/astro";

interface Props {
  slug: string;
  title: string;
  variant?: "card" | "panel";
}

const { slug, title, variant = "card" } = Astro.props;
---

<button
  class:list={["save-job-button", `is-${variant}`]}
  type="button"
  data-save-job={slug}
  data-job-title={title}
  data-analytics-event="save_job_toggle"
  aria-pressed="false"
  aria-label={`Save ${title}`}
>
  <Bookmark size={variant === "panel" ? 18 : 17} stroke-width={2} />
  <span>{variant === "panel" ? "Save this job" : "Save"}</span>
</button>

<style>
  .save-job-button { display:inline-flex; align-items:center; justify-content:center; gap:.45rem; border:1px solid rgba(23,32,51,.11); background:#fff; color:#687182; font:inherit; font-size:.7rem; font-weight:750; cursor:pointer; transition:transform .2s ease,border-color .2s ease,background .2s ease,color .2s ease; }
  .save-job-button.is-card { min-height:2.2rem; padding:.45rem .65rem; border-radius:999px; }
  .save-job-button.is-panel { width:100%; min-height:3rem; border-radius:999px; background:#f7f6f2; font-size:.78rem; }
  .save-job-button:hover { border-color:rgba(91,92,226,.35); color:var(--blue); transform:translateY(-1px); }
  .save-job-button.is-saved { border-color:rgba(91,92,226,.22); background:var(--blue-soft); color:var(--blue); }
  .save-job-button.is-saved :global(svg) { fill:currentColor; }
  .save-job-button:focus-visible { outline:3px solid var(--orange); outline-offset:3px; }
</style>
