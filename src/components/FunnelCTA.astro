---
interface Props {
  class?: string;
}

const { class: additionalClass = "" } = Astro.props;
---

<section class={`mx-4 my-12 rounded-[2rem] bg-[#fff1e9] px-6 py-12 sm:mx-6 sm:px-8 ${additionalClass}`}>
  <div class="max-w-3xl mx-auto text-center">
    <p class="section-eyebrow justify-center">Your next step</p>
    <h3 class="font-brand text-2xl font-extrabold text-[#172033] sm:text-3xl">Turn useful advice into a stronger application.</h3>
    <p class="mt-4 text-base leading-relaxed text-[#687081] sm:text-lg">
      Explore practical interview preparation and career guidance designed for students, job seekers, and early-career people.
    </p>
    <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/interview" class="btn-electric">Prepare for interviews</a>
      <a href="/career" class="btn-outline-electric">Career toolkit</a>
    </div>
  </div>
</section>
