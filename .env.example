# Browser-safe values from Supabase Project Settings > API Keys.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Trusted server/import environments only. Never expose or prefix this with PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Legacy projects may use these aliases instead of the preferred keys above:
# PUBLIC_SUPABASE_ANON_KEY=replace_with_legacy_anon_key
# SUPABASE_SERVICE_ROLE_KEY=replace_with_legacy_service_role_key

# Optional Search Console ownership token (the content value only).
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Monetisation stays off when these are blank. See docs/monetization.md.
PUBLIC_AD_PROVIDER=none
PUBLIC_ADS_PREVIEW=false
PUBLIC_AD_CLIENT_ID=
PUBLIC_AD_JOB_LIST_SLOT_ID=
PUBLIC_AD_BLOG_FEED_SLOT_ID=
PUBLIC_AD_ARTICLE_SLOT_ID=

# Product cards appear only when a valid URL is supplied, or in preview mode.
PUBLIC_PRODUCTS_PREVIEW=false
PUBLIC_INTERVIEW_WORKBOOK_URL=
PUBLIC_JOB_TRACKER_URL=
