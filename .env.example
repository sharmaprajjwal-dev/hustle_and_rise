# Browser-safe values from Supabase Project Settings > API Keys.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Trusted server/import environments only. Never expose or prefix this with PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Legacy projects may use these aliases instead of the preferred keys above:
# PUBLIC_SUPABASE_ANON_KEY=replace_with_legacy_anon_key
# SUPABASE_SERVICE_ROLE_KEY=replace_with_legacy_service_role_key
